{
  "manifest_version": 3,
  "name": "YouTube Loudness Checker",
  "version": "1.1.0",
  "description": "Measure YouTube audio loudness in real-time (LUFS & RMS)",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
